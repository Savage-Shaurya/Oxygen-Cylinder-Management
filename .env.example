# The development server binds to loopback and uses synthetic data by default.
HOST=127.0.0.1
PORT=3001
CTMS_DB_PATH=data/ctms.sqlite
DEMO_MODE=true
# Production requires DEMO_MODE=false, a separately provisioned live database,
# NODE_ENV=production, and a TLS reverse proxy. Never reuse the demo database.

# Hosted demo on Vercel + Supabase (set these in Vercel → Settings → Environment Variables,
# never in a committed file). See docs/deploy-vercel-supabase.md.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_CA_CERT=<contents of the Supabase SSL certificate file, optional but recommended>
